<div class="page-hero">
  <div class="wrap">
    <div class="crumbs"><a href="../../index.html">होम</a> / <a href="../../doctors.html">डॉक्टर</a> / <%= hero.name %></div>
    <h1><%= hero.name %></h1>
    <p class="lead"><%= hero.title %></p>
  </div>
</div>

<section style="padding-top: 32px;"><div class="wrap">
  
  <!-- 1. Hero & 2. मुख्य तथ्य -->
  <div class="doc-profile-grid">
    <div class="photo" style="border-radius: 18px; overflow: hidden; background: var(--teal-soft); box-shadow: var(--shadow-soft);">
      <img src="<%= hero.image.replace('../', '../../') %>" alt="<%= hero.name %>" style="width: 100%; object-fit: cover; display: block;">
    </div>
    <div>
      <h2 style="font-size: 2rem; color: var(--teal-deep); margin-bottom: 8px;"><%= hero.name %></h2>
      <p style="font-weight: 600; color: var(--magenta); margin-bottom: 16px;"><%= hero.title %></p>
      
      <div style="background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 20px; margin-bottom: 24px; box-shadow: var(--shadow-soft);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; border-bottom: 1px solid var(--line); padding-bottom: 8px;">मुख्य तथ्य</h3>
        <ul style="list-style: none; padding: 0;">
          <li style="margin-bottom: 8px;"><strong>योग्यताएं:</strong> <%= hero.qualifications %></li>
          <% quickFacts.forEach(function(fact) { %>
            <li style="margin-bottom: 8px;"><strong><%= fact.label %>:</strong> <%= fact.value %></li>
          <% }); %>
          <li style="margin-bottom: 8px;"><strong>भाषाएं:</strong> <%= languages.join(', ') %></li>

        </ul>
      </div>

      <!-- 18. Book Appointment CTA -->
      <button class="btn btn-primary js-wa" data-doc="<%= hero.name %>" style="font-size: 1.1rem; padding: 12px 24px;">अपॉइंटमेंट बुक करें</button>
    </div>
  </div>

  <div class="doc-content-grid">
    <!-- Main Content Column -->
    <div>
      <!-- 3. Biography -->
      <div class="sec-head"><span class="eyebrow">About</span><h2>Biography</h2></div>
      <div style="font-size: 1.05rem; color: var(--ink); margin-bottom: 48px; line-height: 1.7;">
        <p><%= biography %></p>
      </div>

      <!-- 4. Clinical Philosophy -->
      <div class="sec-head"><span class="eyebrow">Approach</span><h2>Clinical Philosophy</h2></div>
      <div class="quote" style="margin-bottom: 48px;">
        <p>"<%= clinicalPhilosophy %>"</p>
      </div>

      <!-- 5, 6, 7. विशेषज्ञता के क्षेत्र, Conditions, Procedures -->
      <div class="grid-2" style="margin-bottom: 48px;">
        <div class="card">
          <h3>विशेषज्ञता के क्षेत्र</h3>
          <ul class="ticks">
            <% areasOfExpertise.forEach(function(item) { %> <li><%= item %></li> <% }); %>
          </ul>
        </div>
        <div class="card">
          <h3>इलाज की जाने वाली स्थितियां</h3>
          <ul class="ticks">
            <% conditionsTreated.forEach(function(item) { %> <li><%= item %></li> <% }); %>
          </ul>
        </div>
        <div class="card" style="grid-column: 1 / -1;">
          <h3>प्रक्रियाएं</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px;">
            <% proceduresPerformed.forEach(function(item) { %> 
              <span class="btn-spec"><%= item %></span> 
            <% }); %>
          </div>
        </div>
      </div>

      <!-- 8. Common Reasons -->
      <div class="sec-head"><span class="eyebrow">Symptoms</span><h2>मरीजों के आने के सामान्य कारण</h2></div>
      <ul class="ticks" style="margin-bottom: 48px;">
        <% commonReasons.forEach(function(item) { %> <li><%= item %></li> <% }); %>
      </ul>

      <!-- 9. FAQs -->
      <% if (faqs && faqs.length > 0) { %>
      <div class="sec-head"><span class="eyebrow">Questions</span><h2>अक्सर पूछे जाने वाले प्रश्न</h2></div>
      <div style="margin-bottom: 48px;">
        <% faqs.forEach(function(faq) { %>
          <div class="faq">
            <h3><%= faq.question %></h3>
            <p><%= faq.answer %></p>
          </div>
        <% }); %>
      </div>
      <% } %>

      <!-- 10. Videos (Lazy Loaded) -->
      <% if (videos && videos.length > 0) { %>
      <div class="sec-head"><span class="eyebrow">Watch</span><h2>Patient Education Videos</h2></div>
      <div class="video-grid" style="margin-bottom: 48px;">
        <% videos.forEach(function(video) { %>
          <div class="embed">
            <!-- Lazy loading iframe -->
            <iframe loading="lazy" src="<%= video %>" title="YouTube video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        <% }); %>
      </div>
      <% } %>
      
      <!-- 11. समीक्षाएं -->
      <% if (reviews && reviews.rating) { %>
      <div class="sec-head"><span class="eyebrow">Testimonials</span><h2>Patient समीक्षाएं</h2></div>
      <div style="margin-bottom: 48px;">
        <div class="rating-badge" style="margin-bottom: 20px;">
          <b><%= reviews.rating %></b> <span class="stars">★★★★★</span> from <%= reviews.count %> Google समीक्षाएं
        </div>
        <% reviews.featured.forEach(function(rev) { %>
          <div class="quote">
            <p>"<%= rev.text %>"</p>
            <div class="who">— <%= rev.name %></div>
          </div>
        <% }); %>
      </div>
      <% } %>
    </div>

    <!-- Sidebar -->
    <div>
      <!-- 12. Publications -->
      <% if (publications && publications.length > 0) { %>
      <div class="card" style="margin-bottom: 24px;">
        <h3>Memberships & Publications</h3>
        <ul style="padding-left: 18px; color: var(--muted); font-size: 0.9rem; margin-top: 12px;">
          <% publications.forEach(function(pub) { %> <li style="margin-bottom:6px;"><%= pub %></li> <% }); %>
        </ul>
      </div>
      <% } %>

      <!-- 15. Nearby Areas -->
      <div class="card" style="margin-bottom: 24px;">
        <h3>Nearby Areas Served</h3>
        <p style="font-size: 0.85rem;"><%= nearbyAreas.join(', ') %></p>
      </div>

      <!-- 16. Related Treatments -->
      <% if (relatedTreatments && relatedTreatments.length > 0) { %>
      <div class="card" style="margin-bottom: 24px;">
        <h3>Related Treatments</h3>
        <ul style="list-style:none; padding:0;">
          <% relatedTreatments.forEach(function(t) { %>
            <li style="margin-bottom:8px;"><a href="../../treatments/<%= t.slug %>.html" style="color: var(--teal-deep); text-decoration: underline; font-size:0.9rem;"><%= t.title %></a></li>
          <% }); %>
        </ul>
      </div>
      <% } %>
    </div>
  </div>
</div></section>
